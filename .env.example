# Backend
NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/smart-leads
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Set to true for local demo mode without a running MongoDB instance.
# Memory mode auto-seeds demo users, 36 leads, follow-ups, and timeline activity.
USE_MEMORY_DB=false

# Frontend
VITE_API_BASE_URL=http://localhost:5050/api
